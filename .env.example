# Ask Genie Bhai — environment variable template
#
# No real values belong in this file or anywhere in this repository.
# Names and scopes below match docs/FLUTTERFLOW_SUPABASE_FOUNDATION.md
# § Environment Variables. Client-safe values are configured directly in
# FlutterFlow's project settings, not read from this file at runtime;
# server-only values belong in Vercel's environment configuration once a
# backend service exists.

# --- Supabase: client-safe (also usable by local tooling, e.g. Supabase CLI) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase: server-only. Never expose to FlutterFlow or any client. ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# --- Cloudflare R2: server-only. Deferred — see docs/FLUTTERFLOW_SUPABASE_FOUNDATION.md. ---
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if/when public delivery is approved:
R2_PUBLIC_BASE_URL=

# --- Razorpay: future, launch-phase only (see docs/ROADMAP.md Phase 2). ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP: server-only, required before production auth email. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
