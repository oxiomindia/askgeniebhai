# Ask Genie Bhai — environment variable template
#
# No real values belong in this file or anywhere in this repository.
# Names and scopes below match docs/FLUTTERFLOW_SUPABASE_FOUNDATION.md
# § Environment Variables (frontend-agnostic; see ADR 0002). The two
# Supabase variables use the NEXT_PUBLIC_ prefix because Next.js only
# inlines that prefix into browser-bundled code — this is a framework
# requirement, not a change to the naming convention for server-only vars
# below. Configure these in Vercel's environment configuration for
# deployed environments.

# --- Supabase: client-safe (read by lib/supabase/client.ts and server.ts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-only. Never expose to the browser. ---
# SUPABASE_SERVICE_ROLE_KEY is required for the admin console
# (lib/supabase/admin.ts) to read across all partners/users/bookings,
# bypassing RLS — see that file for why.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# --- Admin console: server-only. See lib/admin-auth.ts. ---
# Comma-separated allowlist of emails authorized for /admin routes.
ADMIN_EMAILS=

# --- Admin console: seed-time only, never read at runtime. ---
# Used once by `npm run seed:admin` (scripts/seed-admin.mjs) to create the
# development admin account via Supabase's Admin API. Do not use the
# placeholder password from the build spec — the script refuses it.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- Cloudflare R2: server-only. Deferred — see docs/FLUTTERFLOW_SUPABASE_FOUNDATION.md. ---
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if/when public delivery is approved:
R2_PUBLIC_BASE_URL=

# --- Razorpay: future, launch-phase only (see docs/ROADMAP.md Phase 2). ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP: server-only, required before production auth email. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
