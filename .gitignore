# Ask Genie Bhai — repository-wide ignores
#
# The Flutter/Dart ignores below predate ADR 0002 (frontend migrated to
# Next.js) and are kept only in case any historical FlutterFlow branch
# still exists; no Flutter code is expected in new work.

# --- Environment / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Flutter / Dart (FlutterFlow export) ---
**/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions
.packages
.pub-cache/
.pub/
/pubspec.lock
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/**/GeneratedPluginRegistrant.java
*.iml
*.ipr
*.iws

# --- Node / Next.js / Vercel ---
node_modules/
.next/
out/
.vercel/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Supabase CLI local state ---
supabase/.branches/
supabase/.temp/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
